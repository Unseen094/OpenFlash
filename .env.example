# ─── OpenFlash environment variables ─────────────────────────────────────────
# Copy to .env for local development. All values are optional; the app fails
# closed when payment/firebase configuration is missing.

# ─── Firebase auth (optional) ────────────────────────────────────────────────
# When blank, the app runs in guest-only mode (one-click access, no sync).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: point firebase at the local emulator, e.g. http://localhost:9099
VITE_FIREBASE_EMULATOR=

# ─── Crypto payment wallets (self-custody) ───────────────────────────────────
# REQUIRED in production to accept payments. Without at least one address,
# checkout is disabled and nothing can be paid into an unverified wallet.
# Dev builds fall back to demo addresses so the flow can be tested.
VITE_BTC_ADDRESS=
VITE_ETH_ADDRESS=
VITE_SOL_ADDRESS=

# ETH monitoring requires an Etherscan API key (free tier is fine).
VITE_ETHERSCAN_KEY=
# SOL monitoring requires an RPC endpoint (public or Helius/QuickNode).
VITE_SOL_RPC_URL=
# Optional: override the default Blockstream Esplora endpoint for BTC.
VITE_BLOCKSTREAM_URL=

# ─── Payment monitoring mode ─────────────────────────────────────────────────
#   real       → poll on-chain (default in production)
#   simulated  → demo monitor that fakes a transaction (default in dev)
#   off        → payments disabled entirely
VITE_MONITOR_MODE=

# Amount-matching tolerance in percent (default 0.5). Covers miner fees and
# exchange drift while rejecting egregious underpayment.
VITE_AMOUNT_TOLERANCE_PCT=

# On-chain polling interval in milliseconds (min 5000, default 15000).
VITE_POLL_INTERVAL_MS=

# Optional: server API base URL for Phase-8 server-backed orders/rates.
VITE_API_BASE_URL=
